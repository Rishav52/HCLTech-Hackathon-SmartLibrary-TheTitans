# Copy to .env (never commit it). Real environment variables take precedence over this file.

# LLM backend: auto = Gemini when GEMINI_API_KEY is set, otherwise the offline rule-based backend.
LLM=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Embeddings: auto = local sentence-transformers model if it can load, else the lexical fallback.
EMBEDDER=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Demo conveniences (turn OFF in any real deployment)
AUTO_SEED=1
DEMO_PERSONAS=1
# LIBRARY_DB=./data/library.db
